{
  "name": "codex-white-pet",
  "version": "0.1.0",
  "private": true,
  "description": "小龙娘：白发小龙少女 Codex 桌宠",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "setup": "npm install && npm run assets:fetch",
    "dist:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "dist:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "assets:fetch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-animations.ps1",
    "assets:pack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-animations.ps1",
    "publish:github": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-github.ps1",
    "assets:compact": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/encode-compact-animations.ps1",
    "assets:switch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/switch-animation-set.ps1",
    "test:smoke": "node scripts/smoke.cjs",
    "test:packaged": "node scripts/smoke.cjs --packaged",
    "check": "node --check src/main.cjs && node --check src/drag-physics.cjs && node --check src/codex-app.cjs && node --check src/preload.cjs && node --check src/renderer.js && node --check scripts/codex-hook.cjs && node --check plugins/codex-white-pet/hooks/codex-hook.cjs && node --check scripts/print-hooks.cjs && node --check scripts/install-hooks.cjs && node --check scripts/smoke.cjs && node scripts/check-ps1-bom.cjs",
    "hooks:print": "node scripts/print-hooks.cjs",
    "hooks:install": "node scripts/install-hooks.cjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.8.0"
  }
}
