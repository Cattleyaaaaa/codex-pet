{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/codex-hook.cjs\"",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/codex-hook.cjs\"", "timeout": 3 }]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/codex-hook.cjs\"", "timeout": 3 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/codex-hook.cjs\"", "timeout": 3 }]
      }
    ],
    "Interrupt": [
      {
        "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/codex-hook.cjs\"", "timeout": 3 }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/codex-hook.cjs\"", "timeout": 3 }]
      }
    ]
  }
}
